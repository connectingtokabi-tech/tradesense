VERACODE_API_ID=admin
VERACODE_API_KEY=admin

# Existing PostgreSQL administrator
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_ADMIN_USERNAME=tradesense
POSTGRES_ADMIN_PASSWORD=${TRADESENSE_DATABASE_PASSWORD}

# JFrog database
JFROG_DATABASE_NAME=jfrog
JFROG_DATABASE_USERNAME=jfrog
JFROG_DATABASE_PASSWORD=jfrog
JFROG_DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/jfrog

# Xray databases
XRAY_DATABASE_NAME=xray
XRAY_DATABASE_USERNAME=xray
XRAY_DATABASE_PASSWORD=xray
XRAY_DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/xray

# RabbitMQ used by JFrog Platform services
RABBITMQ_USERNAME=jfrog
RABBITMQ_PASSWORD=jfrog

# Enterprise Plus license
JFROG_LICENSE_FILE=./licenses/jfrog-license.txt

# JFrog Platform and CLI
JF_URL=http://artifactory:8082
JF_XRAY_URL=http://xray:8082
JF_ACCESS_TOKEN=admin
